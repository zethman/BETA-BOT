# ── Data layer (free tier) ─────────────────────────────────────────────
# Any public/free Solana RPC with WebSocket support. Public mainnet RPC
# works but is rate-limited and shared — expect throttling under load.
# Free-tier options: https://api.mainnet-beta.solana.com (public, weakest)
# or a free Helius/QuickNode RPC (better, still not Geyser/Yellowstone).
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Minimum ms between throttled RPC calls (getParsedTransaction, metadata
# fetch). Free public RPC 429s hard under snipe mode's full-program
# firehose — raise this (e.g. 500-1000) if you're still seeing 429s in
# the logs even with the default. A paid RPC/Geyser provider is the real
# fix for snipe-mode volume; see README.
RPC_MIN_INTERVAL_MS=250
# For a dedicated fast RPC, set this to 0 and use a matching WebSocket URL.
# Set true only after dry-run validation: it skips RPC simulation and returns
# as soon as the signed packet is accepted, which reduces latency but means a
# rejected transaction is reported asynchronously by your RPC.
FAST_SUBMIT=false
TX_MAX_RETRIES=2
# Cache shared pump.fun global/fee state briefly; per-mint curve state is
# always fetched fresh.
PROTOCOL_STATE_CACHE_MS=1000

# Optional enrichment (bonding curve %, holder count, risk score).
# Free tier: 2,500 requests/month. Leave blank to run without enrichment
# (bot still works off raw on-chain data, just with fewer filters).
SOLANA_TRACKER_API_KEY=

# ── Wallet ──────────────────────────────────────────────────────────────
# Base58-encoded private key of the TRADING wallet. Use a dedicated
# burner wallet funded only with what you're willing to lose. Never your
# main wallet.
WALLET_PRIVATE_KEY=

# Safety: true by default. Set false only after reviewing all limits below,
# then also set LIVE_TRADING_CONFIRMATION to the exact phrase required by the app.
DRY_RUN=true
LIVE_TRADING_CONFIRMATION=

# ── Mode ────────────────────────────────────────────────────────────────
# snipe | copy | both  (can be overridden with --mode= CLI flag)
MODE=snipe

# Comma-separated wallet addresses to mirror. Only used in copy/both mode.
COPY_TARGET_WALLETS=

# ── Risk management (defaults are intentionally conservative) ──────────
# Max SOL spent per individual trade.
MAX_POSITION_SOL=0.05
# Max total SOL the bot will risk across all open positions at once.
MAX_EXPOSURE_SOL=0.2
# Bot halts new trades for the rest of the UTC day once realized losses
# hit this amount.
DAILY_LOSS_CAP_SOL=0.3
# Minimum seconds between two buys of the SAME mint (anti-double-buy).
PER_TOKEN_COOLDOWN_SEC=60
# Slippage tolerance, in basis points (300 = 3%).
SLIPPAGE_BPS=300
# Priority fee in micro-lamports per compute unit (free-tier RPC still
# respects this; it just won't get you Jito-bundle-level landing odds).
PRIORITY_FEE_MICROLAMPORTS=200000

# ── Exit strategy (applies to positions from either mode) ──────────────
# Sell automatically once unrealized gain hits this %.
TAKE_PROFIT_PCT=50
# Sell automatically once unrealized loss hits this %.
STOP_LOSS_PCT=25
# How often to re-check open positions against TP/SL, in seconds.
EXIT_POLL_INTERVAL_SEC=5

# ── Snipe-mode filters ──────────────────────────────────────────────────
# Skip tokens where the creator's own opening buy exceeds this % of the
# initial bonding curve supply (heuristic for "dev is about to dump").
MAX_DEV_HOLDING_PCT=15
# Require token metadata (name/symbol/image) to be present and non-empty.
REQUIRE_METADATA=true
# Comma-separated creator wallet addresses to always skip.
CREATOR_BLOCKLIST=

# ── Copy-mode filters ─────────────────────────────────────────────────
# Ignore target-wallet trades smaller than this many SOL (skip dust).
MIN_MIRROR_TRADE_SOL=0.02
# How you size your own trade relative to the target's trade.
# fixed = always MAX_POSITION_SOL; proportional = same % of your bankroll
# as the target's trade was of theirs (requires target bankroll estimate,
# falls back to fixed if unknown).
MIRROR_SIZING_MODE=fixed
